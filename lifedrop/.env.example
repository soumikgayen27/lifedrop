# ---------- Frontend (exposed to the browser; anon key only) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Leave empty in development (Vite proxies /api to the Express server).
# In production set to the public URL of the API, e.g. https://api.example.com
VITE_API_URL=

# ---------- Backend (NEVER expose these to the browser) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
